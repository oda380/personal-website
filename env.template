# Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# =============================================================================
# CLERK AUTHENTICATION
# =============================================================================
# Get these from: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk URLs (will use default routes)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/admin
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/admin

# =============================================================================
# VERCEL POSTGRES DATABASE
# =============================================================================
# Get these from: Vercel Dashboard > Storage > Your Database > .env.local tab
POSTGRES_URL="postgres://..."
POSTGRES_PRISMA_URL="postgres://..."
POSTGRES_URL_NO_SSL="postgres://..."
POSTGRES_URL_NON_POOLING="postgres://..."
POSTGRES_USER="..."
POSTGRES_HOST="..."
POSTGRES_PASSWORD="..."
POSTGRES_DATABASE="..."

# =============================================================================
# OPTIONAL: ADMIN ACCESS CONTROL
# =============================================================================
# Restrict admin access to specific email/wallet address
# Leave blank to allow any authenticated user
ADMIN_EMAIL=your.email@example.com
ADMIN_WALLET_ADDRESS=0x...
